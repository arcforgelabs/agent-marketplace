{
  "name": "@arcforgelabs/openclaw-gohighlevel",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./lib/index.js && node ./scripts/augment-manifest.mjs",
    "plugin:validate": "npm run plugin:build && openclaw plugins validate --entry ./lib/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "lib",
    "skills",
    "src",
    "scripts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "PROVENANCE.json",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.9.3 <=2026.9.4"
  },
  "dependencies": {
    "typebox": "^1.3.18"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./lib/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.3 <=2026.9.4",
      "minGatewayVersion": "2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  },
  "description": "Unofficial HighLevel integration for OpenClaw, with bundled CLI and skill.",
  "license": "MIT",
  "author": {
    "name": "Arc Forge Labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcforgelabs/agent-marketplace.git",
    "directory": "plugins/gohighlevel/openclaw"
  },
  "bin": {
    "ghl": "./lib/cli.js"
  }
}
