{
  "id": "arcforgelabs-xero",
  "name": "Xero",
  "description": "Native OpenClaw Gateway bridge for the Arc Forge Xero connector.",
  "version": "0.4.1",
  "skills": [
    "./skills"
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "xero"
    ]
  },
  "cliCommands": [
    {
      "name": "xero",
      "description": "Run the Xero connector CLI",
      "hasSubcommands": true
    }
  ],
  "mcpServers": {
    "xero": {
      "transport": "streamable-http",
      "url": "http://127.0.0.1:8796/mcp",
      "supportsParallelToolCalls": true,
      "requestTimeoutMs": 130000
    }
  },
  "dashboard": {
    "dataBindings": [
      {
        "id": "status",
        "method": "xero.status",
        "description": "Read local Xero connector readiness without network access."
      },
      {
        "id": "oauth.contract",
        "method": "xero.oauth.contract",
        "description": "Read the redacted OAuth PKCE contract."
      },
      {
        "id": "tenants.local",
        "method": "xero.tenants.local",
        "description": "List locally recorded Xero tenants without refreshing."
      }
    ],
    "actionVerbs": []
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "connectorRoot": {
        "type": "string",
        "description": "Absolute path to connectors/xero when outside the repository layout."
      },
      "commandTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000,
        "default": 30000
      },
      "sharedServiceAutoStart": {
        "type": "boolean",
        "default": true,
        "description": "Start a gateway-owned shared Xero MCP server when none answers on 127.0.0.1:8796."
      }
    },
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "xero_status",
      "xero_evidence_attachments",
      "xero_evidence_audit"
    ]
  },
  "toolMetadata": {
    "xero_status": {
      "replaySafe": true,
      "sideEffecting": false,
      "profiles": [
        "coding",
        "messaging",
        "full"
      ]
    },
    "xero_evidence_attachments": {
      "replaySafe": true,
      "sideEffecting": false,
      "profiles": [
        "coding",
        "full"
      ]
    },
    "xero_evidence_audit": {
      "replaySafe": true,
      "sideEffecting": false,
      "profiles": [
        "coding",
        "full"
      ]
    }
  }
}
